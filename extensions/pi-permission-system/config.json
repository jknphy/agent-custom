{
  "permission": {
    "*": "deny",
    "read": "allow",
    "read:*": "allow",
    "read_file": "allow",
    "read_file:*": "allow",
    "list_dir": "allow",
    "list_dir:*": "allow",
    "glob": "allow",
    "grep": "allow",
    "find": "allow",
    "search": "allow",
    "write": "deny",
    "write:*": "deny",
    "write_file": "deny",
    "write_file:*": "deny",
    "create_file": "deny",
    "edit": "deny",
    "edit_file": "deny",
    "delete": "deny",
    "delete_file": "deny",
    "path": {
      "**": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "*client.conf": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gcp/**": "deny"
    },
    "bash": {
      "*": "deny",
      "ls *": "allow",
      "cat *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "bash */download-iso/download.sh *": "allow",
      "bash */modify-iso/modify.sh *": "allow",
      "bash */prepare-iso/prepare.sh *": "allow",
      "openqa-cli api --host https://openqa.suse.de *": "allow",
      "openqa-cli *-X*": "deny",
      "openqa-cli *--method*": "deny",
      "openqa-cli * -d*": "deny",
      "openqa-cli * --data*": "deny",
      "openqa-cli * -D*": "deny",
      "openqa-cli * --json*": "deny",
      "openqa-cli * -f*": "deny",
      "openqa-cli * --form*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/root/.pi/agent/skills-custom/download-iso/*": "allow",
      "/root/.pi/agent/skills-custom/modify-iso/*": "allow",
      "/root/.pi/agent/skills-custom/prepare-iso/*": "allow",
      "/root/Downloads/isos/*": "allow"
    },
    "skill": {
      "*": "deny",
      "download-iso": "allow",
      "modify-iso": "allow",
      "prepare-iso": "allow"
    }
  }
}
